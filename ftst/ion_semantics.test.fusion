(require
  "/fusion/experimental/check"
  "/fusioncontrib/denotation"
  "/fusioncontrib/denotation/testing"
  "/ion_semantics/model"
  "/ion_semantics/testing"
)


// Here we follow the convention that symbols starting with '#$' denote SIDS.
// When converting the input data to the denotational input, we make numeric SymToks.
// When converting the denotational output to data, we turn numeric Symbolics into that form.
// That allows us to use Fusion `===` operator to validate correct behavior.

(check_expansion
  (quote_top true false 1)
  (quote_top true false 1))


// Symbols

(check_expansion
  (quote_top danny $ion  '#$0')
  (quote_top danny '#$1' '#$999'))

// Lists

(check_expansion
  (quote_top [] [[], 1, danny, $ion])
  (quote_top [] [[], 1, danny, '#$1']))


// Structs

(check_expansion
  (quote_top {} {a:$ion, c:{}, a:1, b:danny})
  (quote_top {} {a:1, b: danny, a:'#$1', c:{}}))


"SUCCESS (ion_semantics.test)"
