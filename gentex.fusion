(require
  "/fusioncontrib/denotation/printing"
  "/ion_model/latex"
  "/ion_model/model"
)


(displayln "%%%---------------------------------------------------------")
(displayln "%%% This file was generated at " (timestamp_now))
(displayln "%%%---------------------------------------------------------")
// Adding any blank lines will cause TeX to complain if this whole file is
// included into AsciiDoc.


// Print AsciiDoc tags around each definition, so they can be included into
// the document individually.

(displayln "% tag::domains[]")
(for [(v (model_domains Ion))]
  (displayln "% tag::" (domain_name v) "[]")
  (ion_print_latex v)
  (displayln "% end::" (domain_name v) "[]")
  (displayln "\\newline")
)
(displayln "% end::domains[]")

(displayln "% tag::functions[]")
(for [(v (model_fns Ion))]
  (displayln "\\newline")
  (displayln "% tag::" (fn_name v) "[]")
  (ion_print_latex v)
  (displayln "% end::" (fn_name v) "[]")
  (displayln "\\newline")
)
(displayln "% end::functions[]")


// Things we can print:
//  * Domain names
//  * Domain signatures
//  * Domain definitions ( name = signature )
//  * Function names
//  * Function signatures
//  * Function definitions (name = body / signature )
//
// Challenges:
//  * Domain names have characters like '*' that can't be in TeX command names.
